# ============================================================
# Server Configuration Example
# 이 파일을 config/server.env로 복사하여 사용하세요
# ============================================================

# 서버 포트 (기본값: 5181)
PORT=5181

# 서버 호스트 (기본값: 0.0.0.0 - 모든 인터페이스)
# 로컬 전용: 127.0.0.1
HOST=0.0.0.0

# CORS 허용 오리진 (쉼표로 구분, 기본값: * - 모든 오리진 허용)
# 프로덕션 예시: http://192.168.1.100:5173,http://localhost:5173
CORS_ORIGINS=*

# 디버깅 JSON 생성 활성화 (기본값: false)
ENABLE_DEBUG_JSON=false

# 데이터베이스 파일 경로 (상대 경로 또는 절대 경로)
DB_PATH=./server/figma-viewer.db

# Claude API 키 (스펙문서 생성용)
ANTHROPIC_API_KEY=
