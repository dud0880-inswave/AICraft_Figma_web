{
  "name": "aicraft-figma",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @aicraft/server\" \"npm run dev -w @aicraft/client\"",
    "dev:client": "npm run dev -w @aicraft/client",
    "dev:server": "npm run dev -w @aicraft/server",
    "build": "npm run build -w @aicraft/server && npm run build -w @aicraft/client",
    "build:client": "npm run build -w @aicraft/client",
    "build:server": "npm run build -w @aicraft/server",
    "test": "npm run test -w @aicraft/client",
    "test:run": "npm run test:run -w @aicraft/client",
    "server": "npm run start -w @aicraft/server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
