# ============================================================
# Figma Viewer Backend Configuration
# ============================================================

# 서버 포트 (기본값: 5181)
PORT=5181

# 디버깅 JSON 생성 활성화 (기본값: false)
# true로 설정하면 자동 매핑 시 signature-debug-{timestamp}.json 파일 생성
ENABLE_DEBUG_JSON=false
